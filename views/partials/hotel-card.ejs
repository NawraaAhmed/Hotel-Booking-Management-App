<div class="hotel-card">
  <div class="hotel-card-info">
    <div class="hotel-card-title">
      <h3><%= hotel.name %></h3>
      <span><%= "⭐".repeat(hotel.rating) %> (<%= hotel.rating %>-star)</span>
    </div>

    <p>📍 <%= hotel.location %></p>

    <p><a href="<%= hotel.mapUrl %>"> View on Google Maps</a></p>

    <img
      class="hotel-card-image"
      src="<%= hotel.image %>"
      alt="<%= hotel.name %>"
      width="200"
    />

    <a class="button" href="/hotels/<%= hotel._id %>">More Details</a>

    <% const isFavorited = user && hotel.favoriteByUsers.some(oneUserId => oneUserId.equals(user._id)); %>
      <% if (isFavorited) { %>
        <form action="/hotels/<%= hotel._id %>/unfavorite" method="POST">
          <input type="hidden" name="returnTo" value="<%= returnTo %>" />
          <button type="submit" class="heart-button" title="Remove from favorites">❤️</button>
        </form>
      <% } else { %>
        <form action="/hotels/<%= hotel._id %>/favorite" method="POST">
          <input type="hidden" name="returnTo" value="<%= returnTo %>" />
          <button type="submit" class="heart-button" title="Add to favorites">🤍</button>
        </form>
      <% } %>
  </div>
</div>
