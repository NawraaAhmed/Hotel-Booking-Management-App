<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Hotels</title>
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <h1>All Hotels</h1>

    <div class="hotel-list">
      <% hotels.forEach(hotel => { %>
        <%- include('../partials/hotel-card', { hotel, returnTo: "/hotels" }) %>
      <% }) %>
    </div>

  </body>
</html>
