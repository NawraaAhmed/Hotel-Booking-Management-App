<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Favorites</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <main>
      <h1>My Favorites</h1>

      <% if (hotels.length === 0) { %>
        <p class="muted">You have no favorite hotels yet.</p>
      <% } %>

      <ul class="favorites-list">
        <% hotels.forEach(hotel => { %>
          <li>
            <form action="/hotels/<%= hotel._id %>/unfavorite" method="POST">
              <a href="/hotels/<%= hotel._id %>"><%= hotel.name %></a>
              <input type="hidden" name="returnTo" value="/hotels/favorites" />
              <button type="submit" class="heart-button" title="Remove from favorites">❤️</button>
            </form>
          </li>
        <% }) %>
      </ul>
    </main>

  </body>
</html>
