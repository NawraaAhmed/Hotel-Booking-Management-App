<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Write a Review</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <main>
      <h1>Review <%= booking.hotel.name %></h1>
      <p class="muted">Your stay: <%= booking.checkIn %> to <%= booking.checkOut %></p>

      <% if (error) { %>
        <p class="error-message"><%= error %></p>
      <% } %>

      <form class="form-card" action="/reviews" method="POST">
        <input type="hidden" name="bookingId" value="<%= booking._id %>" />

        <label for="rating">Rating (1–5):</label>
        <input type="number" id="rating" name="rating" min="1" max="5" step="1" value="<%= formData.rating %>" required />

        <label for="comment">Comment:</label>
        <textarea id="comment" name="comment" required><%= formData.comment %></textarea>

        <button type="submit">Submit Review</button>
      </form>
    </main>
  </body>
</html>
