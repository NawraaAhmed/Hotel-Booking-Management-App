<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
  </head>
  <body>
    <%- include('./partials/navbar') %>

    <% if (message) { %>
      <p class="success-message"><%= message %></p>
    <% } %>

    <h1>Welcome to Mabeet<% if (user) { %>, <%= user.username %><% } %>!</h1>
    <p>Find and book your perfect stay in Bahrain.</p>

    <h2>Top 5-Star Hotels</h2>
    <div class="hotel-list">
      <% topHotels.forEach(hotel => { %>
        <%- include('./partials/hotel-card', { hotel }) %>
      <% }) %>
    </div>

  </body>
</html>
