<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Bookings</title>
    <link rel="stylesheet" href="/css/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js" defer></script>
    <script src="/js/alerts.js" defer></script>
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <main>
      <% if (message) { %>
        <p class="success-message"><%= message %></p>
      <% } %>

      <h1>My Bookings</h1>

      <% if (bookings.length === 0) { %>
        <p class="muted">You have no bookings yet. <a href="/hotels">Browse hotels</a></p>
      <% } %>

      <% bookings.forEach(booking => { %>
        <div class="booking">
          <h3><%= booking.hotel ? booking.hotel.name : "Hotel no longer available" %></h3>
          <p><%= booking.checkIn %> to <%= booking.checkOut %></p>
          <p><%= booking.rooms %> × <%= booking.roomType %> room(s) — Total: BHD <%= booking.totalPrice %></p>
          <% if (booking.checkOut < today) { %>
            <p>Status: Completed</p>
          <% } else if (booking.checkIn <= today) { %>
            <p>Status: Current stay</p>
          <% } else { %>
            <p>Status: Upcoming</p>
          <% } %>
          <div class="actions">
            <a class="button button-secondary" href="/bookings/<%= booking._id %>">View Details</a>
          </div>
        </div>
      <% }) %>
    </main>
  </body>
</html>
